<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Host wiring for TeleForge. AddTelegramMonolithHost composes ingress, routing and sending in one call; separate ingress and sender hosts are available for a split deployment.</Description>
        <PackageTags>telegram;telegram-bot;bot;hosting;webhook;dependency-injection</PackageTags>
    </PropertyGroup>

    <PropertyGroup>
        <RootNamespace>TeleForge.Hosting</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TeleForge.Core\TeleForge.Core.csproj"/>
        <ProjectReference Include="..\TeleForge.Contracts\TeleForge.Contracts.csproj"/>
        <ProjectReference Include="..\TeleForge.Consumer\TeleForge.Consumer.csproj"/>
        <ProjectReference Include="..\TeleForge.Messaging\TeleForge.Messaging.csproj"/>
        <ProjectReference Include="..\TeleForge.Messaging.Abstractions\TeleForge.Messaging.Abstractions.csproj"/>
        <ProjectReference Include="..\TeleForge.Messaging.MassTransit\TeleForge.Messaging.MassTransit.csproj"/>
        <ProjectReference Include="..\TeleForge.Routing\TeleForge.Routing.csproj"/>
        <ProjectReference Include="..\TeleForge.Routing.Abstractions\TeleForge.Routing.Abstractions.csproj"/>
        <ProjectReference Include="..\TeleForge.Observability\TeleForge.Observability.csproj"/>
        <ProjectReference Include="..\TeleForge.RateLimiting.Abstractions\TeleForge.RateLimiting.Abstractions.csproj"/>
        <ProjectReference Include="..\TeleForge.RateLimiting.Redis\TeleForge.RateLimiting.Redis.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MassTransit"/>
        <PackageReference Include="MassTransit.RabbitMQ"/>
        <PackageReference Include="StackExchange.Redis"/>
    </ItemGroup>

</Project>
