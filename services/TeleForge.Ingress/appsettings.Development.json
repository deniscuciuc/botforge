{
  "Telegram": {
    "Bots": [
      {
        "Key": "main",
        "Token": "YOUR_BOT_TOKEN_HERE"
      }
    ],
    "Consumer": {
      "ConcurrencyLimit": 10
    },
    "Queue": {
      "Backend": "InMemory"
    },
    "Observability": {
      "EnableMetrics": false,
      "EnablePrometheusExporter": false
    }
  },
  "Urls": "http://localhost:8080",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "TeleForge": "Debug"
    }
  }
}
