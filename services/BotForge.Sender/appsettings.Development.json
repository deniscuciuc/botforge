{
  "Telegram": {
    "Bots": [
      {
        "Key": "main",
        "Token": "YOUR_BOT_TOKEN_HERE"
      }
    ],
    "Queue": {
      "Backend": "RabbitMq",
      "RabbitMqConnectionString": "amqp://guest:guest@localhost:5672/"
    },
    "Observability": {
      "EnableMetrics": false,
      "EnablePrometheusExporter": false
    }
  },
  "Urls": "http://localhost:8081",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "BotForge": "Debug",
      "MassTransit": "Debug"
    }
  }
}
