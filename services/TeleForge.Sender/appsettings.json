{
  "Telegram": {
    "Bots": [
      {
        "Key": "main",
        "Token": "YOUR_BOT_TOKEN_HERE",
        "GlobalPerSecond": 30,
        "PerChatPerSecond": 1,
        "GroupPerMinute": 20
      }
    ],
    "Queue": {
      "Backend": "RabbitMq",
      "RabbitMqConnectionString": "amqp://guest:guest@rabbitmq:5672/",
      "QueuePrefix": "telegram"
    },
    "Send": {
      "RetryCount": 3,
      "RetryBaseDelaySeconds": 1,
      "MaxRetryDelaySeconds": 60,
      "CircuitBreakerFailureThreshold": 10,
      "CircuitBreakerBreakDurationSeconds": 30,
      "UseRetryAfterForBreakDuration": true
    },
    "Observability": {
      "EnableMetrics": true,
      "EnablePrometheusExporter": true,
      "PrometheusPort": 9465
    }
  },
  "Urls": "http://+:8081",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TeleForge": "Information",
      "MassTransit": "Information"
    }
  }
}
