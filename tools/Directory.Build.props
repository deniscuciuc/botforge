<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

    <PropertyGroup>
        <!-- Roslyn analyzers and dotnet-new template packs must target netstandard2.0. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <!-- Tools are not a public library API surface. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!--
          Only BotForge.Analyzers and BotForge.Templates.DotNet ship. ApiProbe, Mcp and the
          benchmarks are development tools and opt out by inheriting this.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>
</Project>
