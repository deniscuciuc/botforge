<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageType>Template</PackageType>
        <IsPackable>true</IsPackable>
        <PackageId>TeleForge.Templates.DotNet</PackageId>
        <Title>TeleForge Telegram Framework Templates</Title>
        <Description>dotnet new templates for TeleForge bot projects and handlers</Description>
        <Authors>Denis Cuciuc</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- No lib/ output, so there are no symbols to ship; a .snupkg would be empty. -->
        <IncludeSymbols>false</IncludeSymbols>
        <ContentTargetFolders>content</ContentTargetFolders>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Forward slashes: a backslash glob matches nothing on Linux, so the package shipped empty. -->
        <Content Include="templates/**/*" Exclude="templates/**/bin/**;templates/**/obj/**;templates/Directory.*"/>
        <Compile Remove="**/*"/>
        <None Include="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

</Project>
