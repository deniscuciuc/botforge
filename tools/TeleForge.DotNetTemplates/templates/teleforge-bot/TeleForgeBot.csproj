<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TeleForge.Core" Version="0.1.*"/>
        <PackageReference Include="TeleForge.Routing" Version="0.1.*"/>
        <PackageReference Include="TeleForge.Messaging" Version="0.1.*"/>
        <PackageReference Include="TeleForge.Consumer" Version="0.1.*"/>
        <!--#if (UseObservability) -->
        <PackageReference Include="TeleForge.Observability" Version="0.1.*"/>
        <!--#endif -->
        <!--#if (UseTemplates) -->
        <PackageReference Include="TeleForge.Templates" Version="0.1.*"/>
        <!--#endif -->
        <!--#if (UsePayments) -->
        <PackageReference Include="TeleForge.Payments" Version="0.1.*"/>
        <!--#endif -->
    </ItemGroup>

</Project>
