root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

csharp_new_line_before_open_brace = all
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

[*.{csproj,props,targets,sln,yml,yaml,json,md}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
# --- Analyzers -------------------------------------------------------------
[*.cs]
# IDE0160: the codebase uses file-scoped namespaces throughout.
csharp_style_namespace_declarations = file_scoped:warning

# A library must not capture the caller's SynchronizationContext: an app with one
# (WPF, WinForms, legacy ASP.NET) can otherwise deadlock while generating a document.
dotnet_diagnostic.CA2007.severity = warning
# Public entry points validate their arguments rather than surfacing a
# NullReferenceException from deep inside a renderer.
dotnet_diagnostic.CA1062.severity = warning
# Renderers own streams and OpenXML documents; those must be released.
dotnet_diagnostic.CA1001.severity = warning
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA1063.severity = warning
# Generated output must not depend on the machine's locale: a decimal comma in an XLSX
# cell or a localised date in DOCX front matter is a real, silent corruption.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1310.severity = warning

[src/**/*.cs]
# CA1711 objects to TelegramUpdateDelegate ending in "Delegate", and CA1716 to a middleware
# parameter named `next`. Both are the middleware-pipeline convention every .NET developer
# already knows from ASP.NET Core's RequestDelegate and `next` — renaming them would make
# the framework harder to learn, not more portable.
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1716.severity = none
# CA1000 objects to ValidationResult<T>.Success/Error. Static factories on a generic result
# type are the established .NET pattern, and `ValidationResult<int>.Success(x)` is exactly
# how callers are meant to write it.
dotnet_diagnostic.CA1000.severity = none
# CA1822 wants every member that does not touch instance state made static. Several of
# these types (ConditionalEvaluator, LoopProcessor) are registered in DI on purpose so a
# consumer can replace them; making their members static would mean taking them out of the
# container, which is a worse API for a micro-optimisation.
dotnet_diagnostic.CA1822.severity = suggestion
# CA1848 wants LoggerMessage source generators. Worth revisiting for the send pipeline if
# logging ever shows up in a profile; today the Telegram API call dominates by orders of
# magnitude.
dotnet_diagnostic.CA1848.severity = suggestion
# CA1873 flags log arguments it thinks are expensive to evaluate, but the values it points
# at are already computed for the operation being logged.
dotnet_diagnostic.CA1873.severity = suggestion

[{tests,examples}/**/*.cs]
# xUnit method names are Method_Should_When, which CA1707 objects to.
dotnet_diagnostic.CA1707.severity = none
# Top-level programs and test fixtures do not need namespaces.
dotnet_diagnostic.CA1050.severity = none
# Test code is not a shipped API surface.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1711.severity = none
# CA1861 wants inline constant arrays hoisted to static readonly fields. In a test that
# builds its expected values next to the assertion, inlining is the clearer form.
dotnet_diagnostic.CA1861.severity = none
# A test fixture's Dispose is an xUnit lifecycle hook, not a disposal pattern for callers.
dotnet_diagnostic.CA1063.severity = none
dotnet_diagnostic.CA1816.severity = none
# `throw new Exception(...)` inside a test is a deliberately anonymous failure — the test
# asserts that *something* propagated, not which type.
dotnet_diagnostic.CA2201.severity = none
# Logging-performance rules do not apply to a test's fake logger.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA2254.severity = none
# CA1873 flags log arguments it thinks are expensive; in an example the point is to show
# what is being logged, and the values are already materialised.
dotnet_diagnostic.CA1873.severity = none

[tools/**/*.cs]
# tools/ holds development utilities — Roslyn analyzers, an MCP server, a rate-limit probe
# and benchmarks. They are not a consumed library surface.
# CA1062: Roslyn calls DiagnosticAnalyzer.Initialize itself and never passes null.
dotnet_diagnostic.CA1062.severity = none
# CA1822: making every private helper static adds noise to a tool.
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1304.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
dotnet_diagnostic.CA1862.severity = suggestion
dotnet_diagnostic.CA1865.severity = suggestion
dotnet_diagnostic.CA1866.severity = suggestion
dotnet_diagnostic.CA2007.severity = none
