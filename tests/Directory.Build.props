<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!--
          0618: the Telegram API deprecates members faster than the tests can follow, and a
          test that pins deprecated behaviour is the point. xUnit1031 objects to blocking on
          a task in a fixture teardown.
        -->
        <NoWarn>$(NoWarn);0618;xUnit1031</NoWarn>
    </PropertyGroup>

    <!-- The docs-snippets project is a plain library, not a test project. -->
    <ItemGroup Condition="'$(IsTestProject)' != 'false'">
        <Using Include="Xunit"/>
    </ItemGroup>
</Project>
